# Application Config
PORT=3000

# Database Config
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
DB_SSL=false

# Authentication & Security Secrets
JWT_SECRET=YOUR_JWT_SECRET_HERE
# WAJIB di NODE_ENV=production (fail-closed): Token rahasia untuk memverifikasi webhook callback Foxy via ?token= atau header X-Callback-Token
FOXY_CALLBACK_SECRET=YOUR_FOXY_CALLBACK_SECRET_HERE
# Opsional (rotasi tanpa downtime): Isi sementara dengan secret lama selama pergantian URL webhook di dashboard Foxy
FOXY_CALLBACK_SECRET_PREVIOUS=
# Khusus lokal/non-production: Set "true" hanya jika ingin melewati verifikasi FOXY_CALLBACK_SECRET saat testing lokal (selalu diabaikan di NODE_ENV=production)
ALLOW_INSECURE_CALLBACK=false
# Wajib minimal 32 karakter acak untuk autentikasi API Bot Admin WhatsApp (/api/bot/admin/*)
WA_BOT_ADMIN_TOKEN=YOUR_WA_BOT_ADMIN_TOKEN_AT_LEAST_32_CHARS_HERE

# API Keys
FOXY_API_KEY=YOUR_FOXY_API_KEY_HERE
PGS_KEY=YOUR_PGS_KEY_HERE
PGS_API_KEY=YOUR_PGS_API_KEY_HERE
BREVO_API_KEY=YOUR_BREVO_API_KEY_HERE

# Deployment / Domain Config
FOXY_CALLBACK_URL=https://your-domain.com/api/foxy/callback?token=YOUR_FOXY_CALLBACK_SECRET_HERE
CORS_ORIGINS=https://your-domain.com
APP_BASE_URL=https://your-domain.com
