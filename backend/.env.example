# === Konfigurasi Server & Runtime ===
NODE_ENV=development
PORT=3000
# Catatan: trust proxy = 1 dan batas rate limiter dikonfigurasi pada backend/app.js & middleware/rateLimiters.js.

# === Database PostgreSQL ===
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
# Gunakan DB_SSL=true untuk koneksi DB terenkripsi di hosting yang mendukung TLS
DB_SSL=false

# === Autentikasi & Secret Keamanan ===
# Wajib >= 32 karakter acak kriptografis di production
JWT_SECRET=YOUR_JWT_SECRET_AT_LEAST_32_CHARS_HERE
# Wajib di NODE_ENV=production (fail-closed): verifikasi webhook callback Foxy via ?token= atau header X-Callback-Token
FOXY_CALLBACK_SECRET=YOUR_FOXY_CALLBACK_SECRET_HERE
# Opsional rotasi zero-downtime: isi sementara dengan secret lama saat mengganti URL webhook di dashboard Foxy
FOXY_CALLBACK_SECRET_PREVIOUS=
# Khusus lokal non-production saja: set "true" hanya bila ingin melewati cek FOXY_CALLBACK_SECRET saat simulasi lokal
ALLOW_INSECURE_CALLBACK=false
# Wajib minimal 32 karakter acak untuk autentikasi endpoint Bot Admin WhatsApp (/api/bot/admin/*)
WA_BOT_ADMIN_TOKEN=YOUR_WA_BOT_ADMIN_TOKEN_AT_LEAST_32_CHARS_HERE

# === Integrasi Provider, Validasi ID, & Mailer ===
# Opsional override base URL API Foxy (default: https://api.foxygamestore.com; ubah ke mock lokal saat QA/sandbox)
FOXY_BASE_URL=https://api.foxygamestore.com
FOXY_API_KEY=YOUR_FOXY_API_KEY_HERE
PGS_KEY=YOUR_PGS_KEY_HERE
PGS_API_KEY=YOUR_PGS_API_KEY_HERE
BREVO_API_KEY=YOUR_BREVO_API_KEY_HERE

# === Domain, Callback URL, & CORS ===
FOXY_CALLBACK_URL=http://localhost:3000/api/foxy/callback?token=YOUR_FOXY_CALLBACK_SECRET_HERE
APP_BASE_URL=http://localhost:3000
# Whitelist CORS dipisah koma (tanpa spasi/wildcard '*'); di production wajib domain resmi mis. https://mikutopup.my.id
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# === Kuota Harian Opsional Reseller H2H (biarkan kosong jika nonaktif) ===
H2H_DAILY_MAX_ORDERS=
H2H_DAILY_MAX_AMOUNT=

# === Opsional Seeder Data Dummy Lokal (npm run seed; ditolak di production) ===
SEED_QA_PASSWORD=
